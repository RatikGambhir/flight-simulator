{
	admin off
	auto_https off
}

# Railway sets PORT; 8080 is the local fallback.
:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	file_server

	# Vite fingerprints everything under /assets, so it can be cached forever.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Unhashed files (index.html, sim.wasm, textures) must revalidate so a deploy
	# never pairs a new index.html with a stale simulation core.
	@unhashed not path /assets/*
	header @unhashed Cache-Control "no-cache"
}
