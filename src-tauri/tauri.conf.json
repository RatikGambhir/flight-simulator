{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeoFlight",
  "version": "0.1.0",
  "identifier": "app.geoflight.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GeoFlight",
        "width": 1600,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#05070c"
      }
    ],
    "macOSPrivateApi": false,
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https: data: blob:",
        "img-src": "'self' data: blob: https:",
        "script-src": "'self' 'wasm-unsafe-eval' blob:",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "SimulationGame",
    "shortDescription": "Fly anywhere on a photorealistic Earth",
    "copyright": "GeoFlight contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}